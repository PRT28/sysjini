# Email Configuration for Contact Form using Nodemailer
# Copy this file to .env.local and fill in your actual values

# Gmail Configuration (Recommended)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Google Sheets Configuration
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project",...}

# Admin Panel Configuration
ADMIN_PASSWORD=your-secure-admin-password

# Contact Modal Configuration
NEXT_PUBLIC_ENABLE_CONTACT_MODAL=true
NEXT_PUBLIC_MODAL_DELAY_MIN=2500
NEXT_PUBLIC_MODAL_DELAY_MAX=3000

# Development Settings
NODE_ENV=development

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace the placeholder values with your actual credentials

# Gmail Setup:
# - Use an App Password instead of your regular password
# - To generate Gmail App Password:
#   - Go to Google Account settings (https://myaccount.google.com)
#   - Security > 2-Step Verification (enable if not already)
#   - App passwords > Generate new password
#   - Select "Mail" and your device
#   - Use the generated 16-character password in EMAIL_PASSWORD

# Google Sheets Setup:
# 1. Go to Google Cloud Console (https://console.cloud.google.com)
# 2. Create a new project or select existing one
# 3. Enable Google Sheets API
# 4. Create a Service Account:
#    - Go to IAM & Admin > Service Accounts
#    - Click "Create Service Account"
#    - Give it a name like "Sysjini Contact Form"
#    - Create and download the JSON key file
# 5. Create a Google Sheet and copy its ID from the URL
# 6. Share the Google Sheet with the service account email (found in JSON)
# 7. Copy the entire JSON content to GOOGLE_SERVICE_ACCOUNT_KEY
# 8. Copy the Sheet ID to GOOGLE_SHEET_ID

# Admin Panel:
# - Set a secure password for ADMIN_PASSWORD
# - This will be used to access /admin dashboard
